# PostgreSQL (docker-compose : service db-postgres)
# Copier : ./scripts/setup-env.sh ou cp database/.env.example database/.env
# POSTGRES_* doivent correspondre à DB_* dans backend/.env

TZ=Europe/Paris
PGTZ=Europe/Paris
POSTGRES_USER=root
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app_db

# Compte admin seedé au 1er init (voir 01_schema.sql)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
