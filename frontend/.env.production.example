# Build Vite local (npm run build). En prod Docker, ces VITE_* viennent du .env racine
# (build-args docker-compose.prod.yml) — ce fichier est exclus du contexte Docker (.dockerignore).
VITE_API_URL=https://api.app.local
VITE_APP_NAME=Comores Event
VITE_SITE_URL=https://app.app.local
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
