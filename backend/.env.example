# --- Application ---
APP_ENV=development
TZ=Europe/Paris

# --- Auth ---
# Générer : openssl rand -base64 48  (>= 32 caractères en production)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
FRONTEND_URL=http://localhost:3000
# Laisser vide en local (cookie host-only)
COOKIE_DOMAIN=
# false | true | liste d'IP/CIDR (ex: 172.18.0.0/16)
TRUSTED_PROXIES=false

# --- Redis (vide = rate limit en mémoire) ---
REDIS_URL=redis://redis:6379/0

# --- Rate limiting (requêtes / minute / IP) ---
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_API_GLOBAL=300
RATE_LIMIT_PAYMENTS=20

# --- Stripe (clés test en local) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TICKET_PRICE_DAY_CENTS=2000
TICKET_PRICE_PASS_CENTS=3000

# --- SMTP emails client (confirmation billet ; distinct du SMTP Grafana) ---
# Si SMTP_HOST ou SMTP_FROM_ADDRESS est vide : envoi désactivé (no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Comores Event

# --- PostgreSQL (aligner avec database/.env) ---
DB_TYPE=postgres
DB_USER=root
DB_PASS=app_dev_password
DB_HOST_POSTGRES=db-postgres
DB_PORT=5432
DB_NAME=app_db
