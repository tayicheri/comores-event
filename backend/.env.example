# --- Application ---
APP_ENV=development
TZ=Europe/Paris

# --- Auth ---
# Générer : openssl rand -base64 48  (>= 32 caractères en production)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
FRONTEND_URL=http://localhost:3000
# Laisser vide en local (cookie host-only)
COOKIE_DOMAIN=
# false | true | liste d'IP/CIDR (ex: 172.18.0.0/16)
TRUSTED_PROXIES=false

# --- Redis (vide = rate limit en mémoire) ---
REDIS_URL=redis://redis:6379/0

# --- Rate limiting (requêtes / minute / IP) ---
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_API_GLOBAL=300

# --- PostgreSQL (aligner avec database/.env) ---
DB_TYPE=postgres
DB_USER=root
DB_PASS=app_dev_password
DB_HOST_POSTGRES=db-postgres
DB_PORT=5432
DB_NAME=app_db
