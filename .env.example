VITE_APP_NAME=App
VITE_API_URL=https://api.app.local
CADDY_FRONTEND_DOMAIN=app.app.local
CADDY_API_DOMAIN=api.app.local
CADDY_MONITORING_DOMAIN=monitoring.app.local
CADDY_ACME_EMAIL=ops@example.com
FRONTEND_URL=https://app.app.local
COOKIE_DOMAIN=.app.local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password
GRAFANA_BASIC_AUTH_USER=admin
# Optionnel : laissé vide, généré automatiquement par ./scripts/docker-observability.sh
GRAFANA_BASIC_AUTH_HASH=
# Optionnel : laissé vide, défini automatiquement sur https://$CADDY_MONITORING_DOMAIN
GRAFANA_ROOT_URL=
# Optionnel : SMTP pour alertes Grafana
GRAFANA_SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
GRAFANA_SMTP_FROM_NAME=App Monitoring
GRAFANA_SMTP_STARTTLS_POLICY=MandatoryStartTLS
GRAFANA_ALERT_EMAIL=ops@example.com
